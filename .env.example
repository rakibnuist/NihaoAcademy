# ─────────────────────────────────────────────
# NiHao Academy — environment variables
# Copy this file to .env.local and fill in values.
# .env.local is git-ignored and NEVER committed.
# ─────────────────────────────────────────────

# Supabase (required for auth, DB, storage)
# Get from: https://supabase.com → project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic / Claude API (used for AI mock test features — M16)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Resend — transactional email (M11+)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Bunny.net — video CDN (M8)
# Get from: https://panel.bunny.net → storage zones
BUNNY_STORAGE_ZONE=nihao-academy-videos
BUNNY_API_KEY=...

# SSLCommerz — payments (M10) — apply early, takes 3-5 business days
# Get from: https://developer.sslcommerz.com
SSLCOMMERZ_STORE_ID=nihao...
SSLCOMMERZ_STORE_PASSWORD=...

# SSL Wireless — SMS OTP (M3) — apply early, takes 2-4 business days
# Get from: https://www.sslwireless.com
SSL_WIRELESS_API_TOKEN=...
SSL_WIRELESS_SID=NIHAO
